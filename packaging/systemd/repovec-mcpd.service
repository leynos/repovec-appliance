[Unit]
Description=repovec MCP bridge daemon
Requires=qdrant.service repovecd.service
# Ordering via repovec-provision.service's Before= is not enough on its own;
# Requires= is what cancels this start job when the provisioning oneshot fails.
Requires=repovec-provision.service
After=qdrant.service repovecd.service

[Service]
Type=simple
User=repovec
Group=repovec
WorkingDirectory=/var/lib/repovec
Environment=HOME=/var/lib/repovec
ExecStart=/usr/bin/repovec-mcpd
Restart=on-failure
