# Keep Qdrant private to the appliance host; repovec services reach it via localhost.
#
# Both directive kinds are required against the provisioning units. The
# repovec-provision.service Before= line only orders this unit; ordering and
# requirement dependencies are orthogonal, so Before= alone would still let
# Qdrant start after a failed sysusers/tmpfiles run. Requires= is what cancels
# this start job so the appliance fails closed rather than mounting a missing
# or misowned storage directory.
[Unit]
Requires=repovec-qdrant-api-key.service repovec-provision.service
After=repovec-qdrant-api-key.service

[Container]
Image=docker.io/qdrant/qdrant:v1
AutoUpdate=registry
Secret=repovec-qdrant-api-key,type=env,target=QDRANT__SERVICE__API_KEY
PublishPort=127.0.0.1:6333:6333
PublishPort=127.0.0.1:6334:6334
Volume=/var/lib/repovec/qdrant-storage:/qdrant/storage:Z
