[Unit]
Description=Provision the repovec Qdrant API key
Documentation=man:podman-secret(1)
Wants=systemd-sysusers.service
After=systemd-sysusers.service
# The helper writes /etc/repovec, so it must not run before the provisioning
# oneshot has created the account and directory tree. Before= on the oneshot
# only orders this unit; Requires= is what makes a failed provisioning run
# cancel this start job.
Requires=repovec-provision.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/repovec/repovec-qdrant-api-key
StandardOutput=journal
StandardError=journal
